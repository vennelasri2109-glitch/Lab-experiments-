/* program to take marks of 5 subjects in integers,and
find the total, average in float*/
#include <stdio.h>
int main()
{
    int a,b,c,d,e,total;
    float avg;
    printf("Enter marks of 5 subjects:");
    scanf("%d%d%d%d%d",&a,&b,&c,&d,&e);
    total= a + b + c + d + e;
    avg = total / 5.0;
    printf("Total marks = %d\n",total);
    printf("Average marks = %.2f",avg);
}
