/*program to find the max and min of four given
numbers using if-else*/
#include <stdio.h>
int main()
{
    int a, b, c, d, max, min;
    printf("\nEnter four numbers: ");
    scanf("%d%d%d%d", &a, &b, &c, &d);
    max = min = a;
    if (b > max)
        max = b;
    else if (b < min)
        min = b;
    if (c > max)
        max = c;
    else if (c < min)
        min = c;
    if (d > max)
        max = d;
    else if (d < min)
        min = d;
    printf("Maximum = %d\n", max);
    printf("Minimum = %d", min);
    return 0;
}
