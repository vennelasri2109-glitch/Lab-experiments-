/*C program to finding compound interest for a given
principal amount, rate of interest, and time period*/
#include<stdio.h>
#include<math.h>
void main()
{
    float P,R,T,CI;
    printf("enter principal amount in rupees");
    scanf("%f",&P);
    printf("enter rate of interest");
    scanf("%f",&R);
    printf("enter time period in months");
    scanf("%f",&T);
    CI=P*pow(1+R/100,T)-P;
    printf("compound interest=%0.2f",CI);
}    
    
    
