//C program to  calculate distance travelled by an object
#include<stdio.h>
#include<math.h>
void main()
{
    float speed,time,distance;
    printf("Enter speed in m/s");
    scanf("%f",&speed);
    printf("enter time in sec");
    scanf("%f",&time);
    distance = speed * time;
    printf("Distance travelled = %.2f", distance);
}    
