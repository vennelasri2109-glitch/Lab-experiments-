/*C program to simple interest calculation for a given
principal amount, rate of interest, and time period*/
#include<stdio.h>
void main()
{
float P,N,R,SI;
printf("enter the principal amount in rupees:");
scanf("%f",&P);
printf("enter the time duration in months");
scanf("%f",&N);
printf("enter the rate of interest");
scanf("%f",&R);
SI=P*N*R/100;
printf("simple interest is %f",SI);
}



